DB_HOST=localhost
DB_PORT=3306
DB_NAME=trouve_ton_artisan
# Compte de l'application : lecture / écriture uniquement (database/create_user.sql)
DB_USER=tta_app
DB_PASSWORD=
# Compte d'administration : seed, création de l'admin, tests, sauvegardes
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Dossier des binaires mysql / mysqldump pour les sauvegardes (XAMPP sur macOS)
MYSQL_BIN_DIR=/Applications/XAMPP/bin

PORT=5000
CLIENT_URL=http://localhost:5173

# SMTP – ex. Mailtrap : sandbox.smtp.mailtrap.io / port 2525
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Authentification : longue chaîne aléatoire, différente en production
# (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# MongoDB (messages de contact) – en production : URI MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/trouve_ton_artisan

# Compte administrateur, créé ou mis à jour par : npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
